  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    },
    "schemas": {
      "RegisterInput": {
        "type": "object",
        "properties": {
          "username": {
            "type": "string",
            "example": "example_user"
          },
          "name": {
            "type": "string",
            "example": "Alice"
          },
          "age": {
            "type": "integer",
            "example": 25
          },
          "email": {
            "type": "string",
            "example": "example@example.com"
          },
          "password": {
            "type": "string",
            "example": "password123"
          }
        }
      },
      "LoginInput": {
        "type": "object",
        "properties": {
          "username": {
            "type": "string",
            "example": "example_user"
          },
          "password": {
            "type": "string",
            "example": "password123"
          }
        }
      },
      "TokenInput": {
        "type": "object",
        "properties": {
          "access_token": {
            "type": "string",
            "example": "ey..."
          }
        }
      },
      "MessageResponse": {
        "type": "object",
        "properties": {
          "message": {
            "type": "string",
            "example": "User registered successfully"
          }
        }
      },
      "ErrorResponse": {
        "type": "object",
        "properties": {
          "error": {
            "type": "string",
            "example": "User already exists"
          }
        }
      },
      "LoginResponse": {
        "type": "object",
        "properties": {
          "access_token": {
            "type": "string",
            "example": "ey..."
          }
        }
      },
      "ProfileResponse": {
        "type": "object",
        "properties": {
          "username": {
            "type": "string",
            "example": "example_user"
          },
          "name": {
            "type": "string",
            "example": "Alice"
          },
          "age": {
            "type": "integer",
            "example": 25
          },
          "email": {
            "type": "string",
            "example": "example@example.com"
          }
        }
      },

      "GameInput": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string",
            "example": "UNO"
          },
          "status": {
            "type": "string",
            "example": "active"
          },
          "maxPlayers": {
            "type": "integer",
            "example": 4
          }
        }
      },
      "Game": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "example": "1"
          },
          "title": {
            "type": "string",
            "example": "UNO"
          },
          "status": {
            "type": "string",
            "example": "active"
          },
          "maxPlayers": {
            "type": "integer",
            "example": 4
          },
          "createdAt": {
            "type": "string",
            "format": "date-time",
            "example": "2022-03-23T10:00:00Z"
          }
        }
      },
      "CardInput": {
        "type": "object",
        "properties": {
          "color": {
            "type": "string",
            "example": "blue"
          },
          "value": {
            "type": "string",
            "example": "3"
          },
          "gameId": {
            "type": "string",
            "example": "1"
          }
        }
      },
      "Card": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "example": "1"
          },
          "color": {
            "type": "string",
            "example": "blue"
          },
          "value": {
            "type": "string",
            "example": "3"
          },
          "gameId": {
            "type": "string",
            "example": "1"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time",
            "example": "2022-03-23T10:00:00Z"
          }
        }
      },
      "ScoreInput": {
        "type": "object",
        "properties": {
          "userId": {
            "type": "string",
            "example": "1"
          },
          "gameId": {
            "type": "string",
            "example": "1"
          },
          "score": {
            "type": "integer",
            "example": 200
          }
        }
      },
      "Score": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "example": "1"
          },
          "userId": {
            "type": "string",
            "example": "1"
          },
          "gameId": {
            "type": "string",
            "example": "1"
          },
          "score": {
            "type": "integer",
            "example": 200
          },
          "timestamp": {
            "type": "string",
            "format": "date-time",
            "example": "2022-03-23T10:00:00Z"
          }
        }
      }
    }
  }
}