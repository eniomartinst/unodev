  "components": {
    "schemas": {
      "PlayerInput": {
        "type": "object",
        "properties": {
          "name": { "type": "string", "example": "Alice" },
          "age": { "type": "integer", "example": 28 },
          "email": { "type": "string", "example": "alice@example.com" }
        }
      },
      "Player": {
        "type": "object",
        "properties": {
          "id": { "type": "string", "example": "1" },
          "name": { "type": "string", "example": "Alice" },
          "age": { "type": "integer", "example": 28 },
          "email": { "type": "string", "example": "alice@example.com" },
          "createdAt": { "type": "string", "format": "date-time", "example": "2022-03-23T10:00:00Z" }
        }
      },
      "GameInput": {
        "type": "object",
        "properties": {
          "title": { "type": "string", "example": "UNO" },
          "status": { "type": "string", "example": "active" },
          "maxPlayers": { "type": "integer", "example": 4 }
        }
      },
      "Game": {
        "type": "object",
        "properties": {
          "id": { "type": "string", "example": "1" },
          "title": { "type": "string", "example": "UNO" },
          "status": { "type": "string", "example": "active" },
          "maxPlayers": { "type": "integer", "example": 4 },
          "createdAt": { "type": "string", "format": "date-time", "example": "2022-03-23T10:00:00Z" }
        }
      },
      "CardInput": {
        "type": "object",
        "properties": {
          "color": { "type": "string", "example": "blue" },
          "value": { "type": "string", "example": "3" },
          "gameId": { "type": "string", "example": "1" }
        }
      },
      "Card": {
        "type": "object",
        "properties": {
          "id": { "type": "string", "example": "1" },
          "color": { "type": "string", "example": "blue" },
          "value": { "type": "string", "example": "3" },
          "gameId": { "type": "string", "example": "1" },
          "createdAt": { "type": "string", "format": "date-time", "example": "2022-03-23T10:00:00Z" }
        }
      },
      "ScoreInput": {
        "type": "object",
        "properties": {
          "playerId": { "type": "string", "example": "1" },
          "gameId": { "type": "string", "example": "1" },
          "score": { "type": "integer", "example": 200 }
        }
      },
      "Score": {
        "type": "object",
        "properties": {
          "id": { "type": "string", "example": "1" },
          "playerId": { "type": "string", "example": "1" },
          "gameId": { "type": "string", "example": "1" },
          "score": { "type": "integer", "example": 200 },
          "timestamp": { "type": "string", "format": "date-time", "example": "2022-03-23T10:00:00Z" }
        }
      }
    }
  }
}
